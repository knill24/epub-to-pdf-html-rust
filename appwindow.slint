import { Button, VerticalBox, ProgressIndicator, LineEdit, CheckBox, HorizontalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Rust EPUB Transformer v1.2";
    preferred-width: 500px;
    preferred-height: 420px;

    in-out property <string> epub-path: "No file selected";
    in-out property <string> save-path: "Default (Same as source)";
    in-out property <float> progress: 0.0;
    in-out property <bool> is-busy: false;
    
    // v1.2 Status Feedback
    in-out property <string> status-msg: "Ready";
    in-out property <color> status-color: black;
    
    in-out property <bool> export-pdf: true;
    in-out property <bool> export-html: true;

    callback open-epub-clicked();
    callback select-save-clicked();
    callback transform_clicked();

    VerticalBox {
        padding: 20px;
        spacing: 15px;

        Text {
            text: "EPUB Transformer";
            font-size: 20px;
            horizontal-alignment: center;
        }

        // Source File Selection
        VerticalBox {
            Text { text: "Source File:"; font-weight: 700; }
            LineEdit { text: root.epub-path; enabled: false; }
            Button { text: "Choose EPUB"; clicked => { root.open-epub-clicked() } }
        }

        // Destination Folder (Back by popular demand!)
        VerticalBox {
            Text { text: "Save Folder:"; font-weight: 700; }
            LineEdit { text: root.save-path; enabled: false; }
            Button { text: "Change Destination"; clicked => { root.select-save-clicked() } }
        }

        // Format Selection
        VerticalBox {
            Text { text: "Output Formats:"; font-weight: 700; }
            HorizontalBox {
                spacing: 20px;
                CheckBox { 
                    text: "Searchable PDF"; 
                    checked: root.export-pdf;
                    toggled => {
                        if (!self.checked && !root.export-html) { self.checked = true; }
                        root.export-pdf = self.checked;
                    }
                }
                CheckBox { 
                    text: "Single-File HTML"; 
                    checked: root.export-html;
                    toggled => {
                        if (!self.checked && !root.export-pdf) { self.checked = true; }
                        root.export-html = self.checked;
                    }
                }
            }
        }

        if (root.is-busy) : ProgressIndicator { progress: root.progress; }

        // v1.2 Status Display
        Text {
            text: root.status-msg;
            color: root.status-color;
            horizontal-alignment: center;
            font-weight: 700;
        }

        Button {
            text: root.is-busy ? "Processing..." : "Start Transformation";
            primary: true;
            enabled: !root.is-busy && root.epub-path != "No file selected";
            clicked => { root.transform_clicked() }
        }
    }
}